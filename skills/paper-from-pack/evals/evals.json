{
 "version": 1,
 "cases": [
  {
   "id": "e01-ieee-conf",
   "code": "E1",
   "pack": "cases/e01-ieee-conf/PACK.md",
   "baseline": true,
   "assertions": [
    {
     "type": "files_exist",
     "files": [
      "DRAFT.tex"
     ]
    },
    {
     "type": "pdf_compiles"
    },
    {
     "type": "no_layout_hacks"
    },
    {
     "type": "doc_class",
     "regex": "IEEEtran"
    },
    {
     "type": "pdf_pages_max",
     "max": 4
    },
    {
     "type": "no_identity",
     "strings": [
      "Alex Rowan",
      "Rowan",
      "Northwind",
      "rowanlabs",
      "flakeguard",
      "alex.rowan"
     ]
    },
    {
     "type": "refs_in_pack"
    },
    {
     "type": "files_exist",
     "files": [
      "CLAIMS.md",
      "OPEN.md",
      "SUBMIT.md"
     ]
    },
    {
     "type": "claims_table",
     "min_rows": 5
    },
    {
     "type": "open_sections",
     "patterns": [
      "(?i)what the author must read",
      "(?i)(three|3) sentences"
     ]
    },
    {
     "type": "ai_statement"
    },
    {
     "type": "numbers_in_pack"
    },
    {
     "type": "no_banned_phrases"
    },
    {
     "type": "network_log_ok"
    }
   ]
  },
